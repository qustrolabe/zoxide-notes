{
	"name": "zoxide-notes",
	"version": "1.4.3",
	"description": "Obsidian plugin that tracks visited notes with zoxide-style frecency scoring",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"test": "bun test",
		"release": "bun release.mjs",
		"lint": "eslint src tests release.mjs && stylelint '**/*.css"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@typescript-eslint/parser": "^8.60.0",
		"bun-types": "^1.3.14",
		"esbuild": "0.28.0",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"tslib": "2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"obsidian": "^1.12.3"
	}
}
